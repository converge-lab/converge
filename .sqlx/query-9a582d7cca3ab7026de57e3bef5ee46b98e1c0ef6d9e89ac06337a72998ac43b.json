  "query": "select id, group_id, name, description, repository, created_at\n               from projects\n               where ($1::uuid is null or group_id = $1)\n                 and ($3::uuid is null or id < $3)\n                 and ($4::uuid is null or group_visible(group_id, $4))\n               order by id desc\n               limit $2",
