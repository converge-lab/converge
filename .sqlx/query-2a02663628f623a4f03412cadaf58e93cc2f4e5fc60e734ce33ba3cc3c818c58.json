  "query": "select s.id, s.project_id, s.kind as \"kind: _\", s.external, s.title, s.captured_at\n               from sessions s\n               join projects p on p.id = s.project_id\n               where s.id = $1\n                 and ($2::uuid is null or group_visible(p.group_id, $2))",
