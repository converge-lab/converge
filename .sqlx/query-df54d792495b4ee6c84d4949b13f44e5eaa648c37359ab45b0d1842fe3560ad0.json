{
  "db_name": "PostgreSQL",
  "query": "select s.id, s.project_id, s.kind as \"kind: _\", s.external, s.title, s.captured_at\n               from sessions s\n               join projects p on p.id = s.project_id\n               where ($1::uuid is null or s.project_id = $1)\n                 and ($2::session_kind is null or s.kind = $2)\n                 and ($4::uuid is null or s.id < $4)\n                 and ($5::uuid is null or group_visible(p.group_id, $5))\n               order by s.id desc\n               limit $3",
